# Entorno local (Notion 01 §2). Cópialo como apps/api/.env: `cp apps/api/env.local.example apps/api/.env`.
# Las contraseñas son las del compose local (infra/docker/compose.local.yml) y las llaves solo sirven para
# datos sintéticos en tu máquina. Staging y producción usan sus propios secretos (01 §5); nunca estos.
NODE_ENV=development
DATABASE_URL=postgresql://app_user:app_user_local@127.0.0.1:5432/nutricoach
DATABASE_OWNER_URL=postgresql://app_owner:app_owner_local@127.0.0.1:5432/nutricoach
ENCRYPTION_KEYS=v1:bnV0cmljb2FjaC1sb2NhbC1kZXYta2V5LTAwMDAwMDE=
BLIND_INDEX_KEY=bnV0cmljb2FjaC1sb2NhbC1ibGluZC1pbmRleC0wMDE=
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=nc_session
MAIL_DRIVER=smtp
SMTP_URL=smtp://127.0.0.1:1025
RATE_LIMIT_FACTOR=1
APP_ENV=local
# SEED_DEMO_PASSWORD solo hace falta en staging; en local la semilla usa una contraseña fija.
