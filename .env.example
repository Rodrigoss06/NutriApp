NODE_ENV=production
APP_ENV=production                            # local | staging | production: el catálogo de componentes solo fuera de producción
APP_URL=https://app.DOMINIO                   # https fuera de local: la cookie es Secure según su esquema (ADR-035)
API_INTERNAL_URL=http://api:3001                # la web llega a la API por la red interna; también al compilar la web
DATABASE_URL=postgresql://app_user:CLAVE@postgres:5432/nutricoach
DATABASE_OWNER_URL=postgresql://app_owner:CLAVE@postgres:5432/nutricoach   # solo migraciones
SESSION_COOKIE_NAME=__Host-nc_session          # staging y producción: Secure, Path=/ y sin Domain
ENCRYPTION_KEYS=v1:BASE64_32_BYTES            # AES-256-GCM, admite rotación por versión
BLIND_INDEX_KEY=BASE64_32_BYTES               # HMAC para buscar sobre campos cifrados
RESEND_API_KEY=
MAIL_FROM="NutriCoach <no-responder@DOMINIO>"
MAIL_DRIVER=resend                            # smtp en local y CI (Mailpit)
SMTP_URL=                                     # solo con MAIL_DRIVER=smtp
RATE_LIMIT_FACTOR=1                           # multiplica los límites de intentos; >1 solo en E2E y k6
SEED_DEMO_PASSWORD=                           # solo staging: contraseña de las cuentas demo de pnpm db:seed
SENTRY_DSN=
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/srv/data/uploads
WALG_S3_PREFIX=s3://nutricoach-backups/prod
AWS_ENDPOINT=https://CUENTA.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WALG_LIBSODIUM_KEY=
RESTIC_REPOSITORY=s3:https://CUENTA.r2.cloudflarestorage.com/nutricoach-files
RESTIC_PASSWORD=
