{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".gitignore", ".prettierignore", "prettier.config.js"],
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "NEXT_TELEMETRY_DISABLED",
    "API_INTERNAL_URL",
    "APP_ENV"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL", "APP_ENV"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:golden": {
      "dependsOn": ["transit"]
    },
    "test:int": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "dev:worker": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
