{
  "name": "@nutricoach/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Esquemas Zod de la API y de los eventos, compartidos por api y web.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nutricoach/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . && prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nutricoach/config": "workspace:*",
    "@nutricoach/engine": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
