{
  "name": "@nutricoach/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de cálculo puro y versionado (ADR-007). Se porta desde docs/reference en P1.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@nutricoach/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . && prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:golden": "vitest run test/golden --passWithNoTests"
  },
  "devDependencies": {
    "@nutricoach/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
