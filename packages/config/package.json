{
  "name": "@nutricoach/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/nest": "./eslint/nest.js",
    "./eslint/next": "./eslint/next.js",
    "./prettier": "./prettier.js",
    "./vitest": "./vitest.js",
    "./dependency-cruiser.cjs": "./dependency-cruiser.cjs"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . --ignore-path ../../.prettierignore --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
